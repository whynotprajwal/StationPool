# StationPool Backend Environment Variables

# Security
SECRET_KEY=stationpool-dev-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./stationpool.db

# App Settings
APP_ENV=development
APP_NAME=StationPool API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo OTP (development only - do not use in production)
DEMO_OTP_ENABLED=true
DEMO_OTP_CODE=123456

# Matching Settings
MATCH_WINDOW_MINUTES=15
